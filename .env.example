# Secrets (always required)
SEATSAERO_API_KEY=pro_xxxxxxxxxxxxxxxxxxxxx
NTFY_TOPIC=your-private-topic
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Search settings normally come from config/monitor-config.json (edit via the
# dashboard in docs/). The env vars below override the config for local runs.
#MONITOR_ENABLED=true
#ORIGIN_AIRPORT=MEL
#DESTINATION_AIRPORTS=SIN,KUL,AMD,CGK
#START_DATE=2026-08-21
#END_DATE=2026-08-21
#CARRIERS=QF,VA
#SOURCES=qantas,velocity
#SEAT_COUNT=1
#CABINS=business,economy
#ALERT_MODE=business        # business | economy | both | any
#ONLY_DIRECT=true
#USE_LIVE_SEARCH=false
#NOTIFY_WHEN_EMPTY=false
